# Keys for the decision models. Any one is enough to open the bar; without
# any, the page asks for one. The server tries a model's own key first, then
# a gateway's.

# A gateway key reaches every model the gateway carries: switch models freely.
# OpenRouter carries all of them; Vercel AI Gateway all but Kev and Clef.
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=

# Or each maker's own key.
# Jev (TypeSafe).
TYPESAFE_API_KEY=
# Kev, self-hosted (it serves TypeSafe's API): its base URL, and a key if it wants one.
KEV_BASE_URL=
KEV_API_KEY=
# Clef, Clef Flash and Clef Omni on Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
